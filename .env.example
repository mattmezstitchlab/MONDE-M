# MONDE-M — configuration locale
# Copier ce fichier en `.env` puis adapter. Aucune valeur n'est obligatoire en développement.

# Port d'écoute du serveur (défaut : 3000)
PORT=3000

# Compte éditeur unique de l'espace d'administration.
# À changer impérativement avant toute mise en ligne.
ADMIN_EMAIL=atelier@monde-m.fr
ADMIN_PASSWORD=mondra2026gon

# Secret de signature des cookies de session.
# En production : une chaîne longue et aléatoire (ex. `openssl rand -hex 32`).
SESSION_SECRET=change-me-en-production

# Durée de la session admin, en heures (défaut : 12)
SESSION_HOURS=12

# Mode de développement ou de production (défaut : development)
NODE_ENV=development
